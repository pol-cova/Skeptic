# Google AI (Gemini) Configuration for Skeptic
# 
# This is an OPTIONAL configuration for using Google AI as your model provider.
# Skeptic works with multiple providers (Codex, Bedrock, OpenRouter, Cerebras, Google AI).
# Only configure this if you want to use Google AI (Gemini) models.
#
# Setup Instructions:
# 1. Get a free API key from: https://aistudio.google.com/apikey
# 2. Copy this file to .env (or add these variables to your existing .env)
# 3. Replace the placeholder values below with your actual credentials
# 4. Run: node scripts/preflight/test-google-manual.ts to verify

# Provider type
# Use 'openai-compatible' to access Google AI through OpenAI-compatible endpoint
SKEPTIC_PROVIDER=openai-compatible

# Google AI API endpoint
# IMPORTANT: The trailing slash / is required
SKEPTIC_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Your Google AI API Key
# Replace 'your_google_ai_api_key_here' with your actual key from Google AI Studio
SKEPTIC_API_KEY=your_google_ai_api_key_here

# Gemini Model to use
# Recommended stable models:
#   - gemini-1.5-flash (fast, good balance)
#   - gemini-2.5-flash (latest stable)
#   - gemini-1.5-pro (more capable, slower)
#   - gemini-3.6-flash (cutting edge)
# Run: node scripts/preflight/list-google-models.ts to see all available models
SKEPTIC_MODEL=gemini-1.5-flash
