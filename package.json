{
  "name": "skeptic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm -r --filter '@skeptic/*' --filter demo-app run build && eve build",
    "demo:dev": "pnpm --filter demo-app dev",
    "dev": "eve dev",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "preflight:bedrock": "node scripts/preflight/bedrock.ts",
    "preflight:eve": "eve info",
    "preflight:google-ai": "node scripts/preflight/google-ai.ts",
    "preflight:google-ai-native": "node scripts/preflight/google-ai-native.ts",
    "preflight:model": "node scripts/preflight/model.ts",
    "preflight:package": "pnpm pack --pack-destination .proof/preflight",
    "gate:day1": "node --experimental-strip-types scripts/gate/day1.ts",
    "skeptic": "node --experimental-strip-types packages/cli/src/bin.ts",
    "publish:skeptic": "pnpm --filter @pol-cova/skeptic publish --access public --no-git-checks",
    "start": "eve start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.28",
    "@skeptic/core": "workspace:*",
    "@skeptic/evidence": "workspace:*",
    "@skeptic/playwright-harness": "workspace:*",
    "@skeptic/report": "workspace:*",
    "ai": "7.0.34",
    "eve": "0.27.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@playwright/test": "1.61.1",
    "@types/node": "24.x",
    "eslint": "9.39.3",
    "globals": "16.4.0",
    "prettier": "3.8.1",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  }
}
